<div class="collection-title">
  <h1>{{ collection.title }}</h1>
  {%- if collection.description != blank -%}
    {{ collection.description }}
  {%- elsif section.settings.default_subtitle != blank -%}
    <p>{{ section.settings.default_subtitle }}</p>
  {%- endif -%}
</div>

<section class="container section-space">
  <div class="collection-controls">
    <p id="collection-count">{{ 'collections.general.items_count' | t: count: collection.products_count }}</p>

    <form method="get" action="{{ collection.url }}" data-sort-form>
      <label class="visually-hidden" for="collection-sort">{{ 'collections.sorting.title' | t }}</label>
      <select id="collection-sort" name="sort_by">
        {%- liquid
          assign current_sort = collection.sort_by | default: collection.default_sort_by
        -%}
        {%- for option in collection.sort_options -%}
          {%- case option.value -%}
            {%- when 'manual' -%}{%- assign sort_label = 'مختاراتنا' -%}
            {%- when 'most-relevant' -%}{%- assign sort_label = 'الأكثر صلة' -%}
            {%- when 'best-selling' -%}{%- assign sort_label = 'الأكثر مبيعًا' -%}
            {%- when 'title-ascending' -%}{%- assign sort_label = 'الاسم: أ - ي' -%}
            {%- when 'title-descending' -%}{%- assign sort_label = 'الاسم: ي - أ' -%}
            {%- when 'price-ascending' -%}{%- assign sort_label = 'السعر: من الأقل للأعلى' -%}
            {%- when 'price-descending' -%}{%- assign sort_label = 'السعر: من الأعلى للأقل' -%}
            {%- when 'created-ascending' -%}{%- assign sort_label = 'الأقدم أولًا' -%}
            {%- when 'created-descending' -%}{%- assign sort_label = 'الأحدث أولًا' -%}
            {%- else -%}{%- assign sort_label = option.name -%}
          {%- endcase -%}
          <option value="{{ option.value }}" {% if option.value == current_sort %}selected{% endif %}>{{ sort_label }}</option>
        {%- endfor -%}
      </select>
      <noscript><button type="submit">{{ 'collections.sorting.apply' | t }}</button></noscript>
    </form>
  </div>

  {%- paginate collection.products by section.settings.products_per_page -%}
    {%- if collection.products.size > 0 -%}
      <div class="collection-grid" id="collection-products">
        {%- for product in collection.products -%}
          {%- liquid
            assign lazy_images = true
            if forloop.index <= 4
              assign lazy_images = false
            endif
          -%}
          {% render 'product-card', product: product, lazy: lazy_images %}
        {%- endfor -%}
      </div>

      {%- if paginate.pages > 1 -%}
        <nav class="pagination" aria-label="{{ 'general.pagination.label' | t }}">
          {%- if paginate.previous -%}
            <a class="circle-btn" href="{{ paginate.previous.url }}" aria-label="{{ 'general.pagination.previous' | t }}">
              {% render 'icon', icon: 'right' %}
            </a>
          {%- endif -%}
          {%- for part in paginate.parts -%}
            {%- if part.is_link -%}
              <a href="{{ part.url }}">{{ part.title }}</a>
            {%- else -%}
              <span aria-current="page">{{ part.title }}</span>
            {%- endif -%}
          {%- endfor -%}
          {%- if paginate.next -%}
            <a class="circle-btn" href="{{ paginate.next.url }}" aria-label="{{ 'general.pagination.next' | t }}">
              {% render 'icon', icon: 'left' %}
            </a>
          {%- endif -%}
        </nav>
      {%- endif -%}
    {%- else -%}
      <div class="empty-state">
        {% render 'icon', icon: 'bag' %}
        <h3>{{ 'collections.general.no_products' | t }}</h3>
        <a class="pill" href="{{ routes.all_products_collection_url }}">{{ 'general.continue_shopping' | t }}</a>
      </div>
    {%- endif -%}
  {%- endpaginate -%}
</section>

{% schema %}
{
  "name": "صفحة التشكيلة",
  "settings": [
    { "type": "text", "id": "default_subtitle", "label": "وصف افتراضي", "default": "قطع ليك، وقطع للبنت." },
    { "type": "range", "id": "products_per_page", "label": "منتجات في الصفحة", "min": 8, "max": 48, "step": 4, "default": 24 }
  ]
}
{% endschema %}

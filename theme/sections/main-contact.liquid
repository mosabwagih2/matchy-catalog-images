<div class="collection-title">
  <h1>{{ page.title }}</h1>
  {%- if section.settings.subheading != blank -%}
    <p>{{ section.settings.subheading }}</p>
  {%- endif -%}
</div>

<section class="container section-space contact-page">
  <div class="contact-cards">
    {%- if section.settings.instagram_url != blank -%}
      <a class="contact-card" href="{{ section.settings.instagram_url }}" target="_blank" rel="noopener noreferrer">
        <span class="contact-icon" aria-hidden="true">
          <svg viewBox="0 0 24 24" width="24" height="24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="3" width="18" height="18" rx="5"/><circle cx="12" cy="12" r="4"/><circle cx="17.5" cy="6.5" r="1" fill="currentColor" stroke="none"/></svg>
        </span>
        <strong>انستجرام</strong>
        <span class="contact-handle" dir="ltr">{{ section.settings.instagram_handle }}</span>
        <em>تابعينا وابعتيلنا رسالة</em>
      </a>
    {%- endif -%}

    {%- if section.settings.facebook_url != blank -%}
      <a class="contact-card" href="{{ section.settings.facebook_url }}" target="_blank" rel="noopener noreferrer">
        <span class="contact-icon" aria-hidden="true">
          <svg viewBox="0 0 24 24" width="24" height="24" fill="currentColor"><path d="M13.5 21v-7.5H16l.5-3h-3V8.6c0-.9.3-1.5 1.6-1.5H16.6V4.4c-.3 0-1.3-.1-2.4-.1-2.4 0-4 1.4-4 4.1v2.1H7.5v3h2.7V21h3.3z"/></svg>
        </span>
        <strong>فيسبوك</strong>
        <span class="contact-handle" dir="ltr">{{ section.settings.facebook_handle }}</span>
        <em>كلمينا على صفحتنا</em>
      </a>
    {%- endif -%}

    {%- if section.settings.email != blank -%}
      <a class="contact-card" href="mailto:{{ section.settings.email }}">
        <span class="contact-icon" aria-hidden="true">
          <svg viewBox="0 0 24 24" width="24" height="24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="5" width="18" height="14" rx="3"/><path d="m4 7 8 6 8-6"/></svg>
        </span>
        <strong>البريد الإلكتروني</strong>
        <span class="contact-handle" dir="ltr">{{ section.settings.email }}</span>
        <em>للاستفسارات والطلبات</em>
      </a>
    {%- endif -%}
  </div>

  <div class="contact-layout">
    <div class="contact-form-wrap">
      <h2>ابعتيلنا رسالة</h2>
      <p class="contact-lead">اكتبي استفسارك وهنرد عليكي في أقرب وقت.</p>

      {%- form 'contact', class: 'contact-form' -%}
        {%- if form.posted_successfully? -%}
          <p class="contact-status success" role="status">وصلتنا رسالتك، شكرًا ليكي. هنرد عليكي في أقرب وقت.</p>
        {%- elsif form.errors -%}
          <p class="contact-status error" role="alert">في حاجة ناقصة في البيانات. اتأكدي من الاسم والبريد والرسالة وجرّبي تاني.</p>
        {%- endif -%}

        <div class="contact-row">
          <label>
            <span>الاسم</span>
            <input type="text" name="contact[name]" autocomplete="name" value="{{ form.name }}" required>
          </label>
          <label>
            <span>رقم الموبايل</span>
            <input type="tel" name="contact[phone]" autocomplete="tel" dir="ltr" value="{{ form.phone }}">
          </label>
        </div>
        <label>
          <span>البريد الإلكتروني</span>
          <input type="email" name="contact[email]" autocomplete="email" dir="ltr" value="{{ form.email }}" required>
        </label>
        <label>
          <span>رسالتك</span>
          <textarea name="contact[body]" rows="5" required>{{ form.body }}</textarea>
        </label>
        <button class="pill" type="submit">إرسال الرسالة</button>
      {%- endform -%}
    </div>

    <aside class="contact-help">
      <h2>قبل ما تبعتي رسالة</h2>
      <ul>
        <li><a href="/pages/size-guide">دليل المقاسات</a><span>اعرفي المقاس المناسب ليكي ولبنتك.</span></li>
        <li><a href="/policies/shipping-policy">الشحن والتوصيل</a><span>مدة التوصيل وتكلفته.</span></li>
        <li><a href="/policies/refund-policy">الاستبدال والاسترجاع</a><span>شروط الاستبدال والاسترجاع.</span></li>
      </ul>
      {%- if section.settings.reply_text != blank -%}
        <p class="contact-reply">{{ section.settings.reply_text }}</p>
      {%- endif -%}
    </aside>
  </div>
</section>

{% schema %}
{
  "name": "صفحة تواصل معنا",
  "settings": [
    { "type": "text", "id": "subheading", "label": "الوصف تحت العنوان", "default": "لأي استفسار عن المنتجات أو المقاسات أو الطلبات، إحنا هنا." },
    { "type": "url", "id": "instagram_url", "label": "رابط انستجرام" },
    { "type": "text", "id": "instagram_handle", "label": "اسم حساب انستجرام", "default": "@matchy.family_wear" },
    { "type": "url", "id": "facebook_url", "label": "رابط فيسبوك" },
    { "type": "text", "id": "facebook_handle", "label": "اسم صفحة فيسبوك", "default": "Matchy.family.wear" },
    { "type": "text", "id": "email", "label": "البريد الإلكتروني" },
    { "type": "text", "id": "reply_text", "label": "ملاحظة الرد", "default": "بنرد على رسائلكم في أقرب وقت." }
  ],
  "presets": [{ "name": "صفحة تواصل معنا" }]
}
{% endschema %}

{%- comment -%}
  Cart drawer body and footer. Refreshed by store.js through the Section Rendering
  API (?sections=cart-drawer) after every cart mutation, so the drawer never needs a
  client-side copy of the cart.
{%- endcomment -%}

<div id="cart-drawer-contents" data-cart-count="{{ cart.item_count }}">
  <div class="drawer-body" id="cart-items">
    {%- if cart.item_count > 0 -%}
      {%- for item in cart.items -%}
        <article class="cart-item" data-cart-item="{{ item.key }}" data-unit-price="{{ item.final_price }}" data-unit-original="{{ item.original_price }}">
          <a href="{{ item.url }}">
            {%- if item.image -%}
              <img src="{{ item.image | image_url: width: 200 }}" alt="{{ item.product.title | escape }}" loading="lazy" width="100" height="133">
            {%- endif -%}
          </a>
          <div>
            <h3><a href="{{ item.url }}">{{ item.product.title }}</a></h3>

            {%- unless item.product.has_only_default_variant -%}
              <p>
                {%- for option in item.options_with_values -%}
                  {{ option.name }}: {% render 'age-label', value: option.value %}{% unless forloop.last %}<br>{% endunless %}
                {%- endfor -%}
              </p>
            {%- endunless -%}

            {%- if item.selling_plan_allocation -%}
              <p>{{ item.selling_plan_allocation.selling_plan.name }}</p>
            {%- endif -%}

            <strong data-line-price>
              {{ item.final_line_price | money }}
              {%- if item.original_line_price > item.final_line_price -%}
                <del data-line-original>{{ item.original_line_price | money }}</del>
              {%- endif -%}
            </strong>

            {%- if item.line_level_discount_allocations.size > 0 -%}
              <ul class="line-discounts">
                {%- for discount in item.line_level_discount_allocations -%}
                  <li>{{ discount.discount_application.title }} (−{{ discount.amount | money }})</li>
                {%- endfor -%}
              </ul>
            {%- endif -%}

            <div class="cart-quantity">
              <button data-cart-change="{{ item.key }}"
                      data-quantity="{{ item.quantity | minus: 1 }}"
                      aria-label="{{ 'sections.cart.decrease' | t: title: item.product.title }}">−</button>
              <span>{{ item.quantity }}</span>
              <button data-cart-change="{{ item.key }}"
                      data-quantity="{{ item.quantity | plus: 1 }}"
                      aria-label="{{ 'sections.cart.increase' | t: title: item.product.title }}">+</button>
              <button class="remove" data-cart-change="{{ item.key }}" data-quantity="0">
                {{ 'sections.cart.remove' | t }}
              </button>
            </div>
          </div>
        </article>
      {%- endfor -%}
    {%- else -%}
      <div class="empty-state">
        {% render 'icon', icon: 'bag' %}
        <h3>{{ 'sections.cart.empty_title' | t }}</h3>
        <p>{{ 'sections.cart.empty_text' | t }}</p>
        <a class="pill" href="{{ routes.all_products_collection_url }}">{{ 'general.continue_shopping' | t }}</a>
      </div>
    {%- endif -%}
  </div>

  <div class="drawer-footer" id="cart-footer">
    {%- if cart.item_count > 0 -%}
      {%- if cart.cart_level_discount_applications.size > 0 -%}
        <ul class="cart-discounts">
          {%- for discount in cart.cart_level_discount_applications -%}
            <li>{{ discount.title }} (−{{ discount.total_allocated_amount | money }})</li>
          {%- endfor -%}
        </ul>
      {%- endif -%}

      <div class="cart-total">
        <span>{{ 'sections.cart.subtotal' | t }}</span>
        <strong data-cart-subtotal>{{ cart.total_price | money }}</strong>
      </div>

      <form action="{{ routes.cart_url }}" method="post">
        <button class="pill" type="submit" name="checkout">{{ 'sections.cart.checkout' | t }}</button>
      </form>

      <small>{{ 'sections.cart.taxes_note' | t }}</small>
    {%- endif -%}
  </div>
</div>

{% schema %}
{
  "name": "سلة التسوق الجانبية",
  "settings": []
}
{% endschema %}

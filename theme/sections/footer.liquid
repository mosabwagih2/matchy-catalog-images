<footer class="footer matchy-footer">
  <div class="container">
    <div class="matchy-footer-content">
      <div class="footer-brand">
        <a class="logo" href="{{ routes.root_url }}" aria-label="{{ shop.name }}">
          {%- if section.settings.logo != blank -%}
            <img class="brand-logo" src="{{ section.settings.logo | image_url: width: 360 }}" alt="{{ shop.name | escape }}" width="150" loading="lazy">
          {%- else -%}
            <img class="brand-logo" src="{{ 'matchy-logo.png' | asset_url }}" alt="{{ shop.name | escape }}" width="150" height="64" loading="lazy">
          {%- endif -%}
        </a>
        {%- if section.settings.tagline != blank -%}
          <p>{{ section.settings.tagline }}</p>
        {%- endif -%}
      </div>

      {%- for block in section.blocks -%}
        {%- case block.type -%}
          {%- when 'menu' -%}
            <div class="footer-column" {{ block.shopify_attributes }}>
              <h3>{{ block.settings.heading }}</h3>
              {%- for link in block.settings.menu.links -%}
                <a href="{{ link.url }}">{{ link.title }}</a>
              {%- endfor -%}
            </div>

          {%- when 'help' -%}
            <div class="footer-column" {{ block.shopify_attributes }}>
              <h3>{{ block.settings.heading }}</h3>
              {%- for link in block.settings.menu.links -%}
                <a href="{{ link.url }}">{{ link.title }}</a>
              {%- endfor -%}
              <button data-panel="wishlist">{{ 'general.wishlist.title' | t }}</button>
            </div>

          {%- when 'newsletter' -%}
            <div class="footer-column" {{ block.shopify_attributes }}>
              <h3>{{ block.settings.heading }}</h3>
              {%- if block.settings.text != blank -%}<p>{{ block.settings.text }}</p>{%- endif -%}
              {%- form 'customer', class: 'newsletter-form' -%}
                <input type="hidden" name="contact[tags]" value="newsletter">
                <label class="visually-hidden" for="footer-email">{{ 'general.newsletter.email' | t }}</label>
                <input id="footer-email" type="email" name="contact[email]"
                       placeholder="{{ 'general.newsletter.email' | t }}"
                       autocomplete="email" required>
                <button class="pill" type="submit">{{ 'general.newsletter.submit' | t }}</button>
                {%- if form.posted_successfully? -%}
                  <p class="newsletter-status" role="status">{{ 'general.newsletter.success' | t }}</p>
                {%- elsif form.errors -%}
                  <p class="newsletter-status" role="alert">{{ form.errors.messages.email }}</p>
                {%- endif -%}
              {%- endform -%}
            </div>
        {%- endcase -%}
      {%- endfor -%}
    </div>

    <div class="footer-bottom">
      <span>&copy; {{ 'now' | date: '%Y' }} {{ shop.name }}. {{ 'general.footer.rights' | t }}</span>
      {%- if section.settings.locale_note != blank -%}
        <span>{{ section.settings.locale_note }}</span>
      {%- endif -%}
    </div>
  </div>
</footer>

{% schema %}
{
  "name": "الفوتر",
  "settings": [
    { "type": "image_picker", "id": "logo", "label": "اللوجو" },
    {
      "type": "textarea",
      "id": "tagline",
      "label": "وصف قصير",
      "default": "شبهك في الروح، وشبهك في اللوك.\nأزياء للأم والبنت، للحظاتكم الحلوة."
    },
    {
      "type": "text",
      "id": "locale_note",
      "label": "ملاحظة الدولة والعملة",
      "default": "مصر · الأسعار بالجنيه المصري"
    }
  ],
  "blocks": [
    {
      "type": "menu",
      "name": "قائمة",
      "limit": 2,
      "settings": [
        { "type": "text", "id": "heading", "label": "العنوان", "default": "تسوّق" },
        { "type": "link_list", "id": "menu", "label": "القائمة", "default": "main-menu" }
      ]
    },
    {
      "type": "help",
      "name": "نساعدك تختار",
      "limit": 1,
      "settings": [
        { "type": "text", "id": "heading", "label": "العنوان", "default": "نساعدك تختار" },
        { "type": "link_list", "id": "menu", "label": "القائمة", "default": "footer" }
      ]
    },
    {
      "type": "newsletter",
      "name": "النشرة البريدية",
      "limit": 1,
      "settings": [
        { "type": "text", "id": "heading", "label": "العنوان", "default": "اعرف الجديد" },
        { "type": "textarea", "id": "text", "label": "النص", "default": "سجّل بريدك عشان يوصلك كل جديد." }
      ]
    }
  ]
}
{% endschema %}
